{
    "name": "thevps/laravel-kanban",
    "description": "Reusable multi-board Kanban module for Laravel + Inertia + Vue apps.",
    "license": "MIT",
    "type": "library",
    "authors": [
        { "name": "Volodymyr Stashenko" }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "inertiajs/inertia-laravel": "^2.0|^3.0",
        "spatie/eloquent-sortable": "^5.0",
        "spatie/laravel-medialibrary": "^11.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "laravel/pint": "^1.18"
    },
    "autoload": {
        "psr-4": {
            "Thevps\\Kanban\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Thevps\\Kanban\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Thevps\\Kanban\\KanbanServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
